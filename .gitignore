# Python
__pycache__/
*.py[cod]
*$py.class

# Packaging / editable installs (created by `pip install -e .`)
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# macOS -- these appear the moment the folder is opened in Finder
.DS_Store
._*

# Dropbox writes these when two machines touch the same file
*conflicted copy*

# Editors
.idea/
.vscode/
*.swp
*~

# Safety net: s3view's real config lives in ~/.config/s3view/, but S3VIEW_CONFIG_DIR
# can point anywhere, and that file holds your bucket names and bookmarks.
/config.json
